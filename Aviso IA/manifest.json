{
  "manifest_version": 3,
  "name": "Aviso IA",
  "version": "6.17.0",
  "description": "Avisos y HUD para múltiples asistentes IA; rutas adicionales configurables.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "activeTab",
    "offscreen",
    "scripting",
    "tabGroups",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-v612.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-hook-v62.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "exclude_matches": []
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detector-v62.js"
      ],
      "run_at": "document_start",
      "exclude_matches": []
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shortcut-main-v612.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shortcut-bridge-v612.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hud-v612.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Aviso IA · v6.17",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
