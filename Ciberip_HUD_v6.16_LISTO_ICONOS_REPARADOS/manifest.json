{
  "manifest_version": 3,
  "name": "Ciberip HUD · LISTO ÚNICO",
  "version": "6.16.0",
  "description": "HUD global: icono verde y grupo LISTO se reparan automáticamente; al abrir o reabrir un chat sale de LISTO y recupera su icono normal.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "activeTab",
    "offscreen",
    "scripting",
    "tabGroups",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-v612.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page-hook-v62.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "detector-v62.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shortcut-main-v612.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shortcut-bridge-v612.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hud-v612.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Ciberip HUD · v6.16",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
